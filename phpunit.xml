<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!--
        `restrictDeprecations` narrows deprecation reporting to the source set
        below, so a dev dependency that has not caught up with a new PHP
        release is not reported as ours. PHPUnit 12 honours the old attribute
        name; PHPUnit 11 does not, and the name it wants
        (`ignoreIndirectDeprecations`) does not exist in PHPUnit 10's schema,
        which the PHP 8.1 leg is pinned to. One config cannot satisfy all
        three, so `failOnDeprecation` is not set here: CI turns it on with
        PHPUnit's fail-on-deprecation flag on the one leg where the filter is honoured
        (PHP 8.5 / Laravel 13 / PHPUnit 12), which is also the leg that would
        see a new 8.5 deprecation first.
    -->
    <source restrictDeprecations="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AckfSECXIvnK5r28GVIWUAxmbBSjTsmF11FallntVGw="/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
